# Copy to .env and fill in. Without DATABASE_URL the app falls back to
# the local JSON store at .data/db.json, so it still runs with no setup.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
SESSION_SECRET=change-me

# Telegram bot. Bo'sh bo'lsa bot butunlay o'chirilgan holatda qoladi.
TELEGRAM_BOT_TOKEN=
# Ixtiyoriy, lekin tavsiya etiladi: webhook uchun tasodifiy maxfiy satr.
TELEGRAM_WEBHOOK_SECRET=
